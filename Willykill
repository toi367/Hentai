local P=game:GetService("Players")
local UIS=game:GetService("UserInputService")
local M=P.LocalPlayer

local G=Instance.new("ScreenGui")
G.Name="BlackRedGUI"
G.ResetOnSpawn=false
G.Parent=M:WaitForChild("PlayerGui")

-- ON/OFF
local Toggle=Instance.new("TextButton",G)
Toggle.Size=UDim2.new(0,70,0,35)
Toggle.Position=UDim2.new(0,10,.5,-18)
Toggle.BackgroundColor3=Color3.fromRGB(130,0,0)
Toggle.Text="ON"
Toggle.TextColor3=Color3.new(1,1,1)
Toggle.TextSize=16
Toggle.Font=Enum.Font.GothamBold
Instance.new("UICorner",Toggle).CornerRadius=UDim.new(0,8)

-- GUI
local F=Instance.new("Frame",G)
F.Size=UDim2.new(0,240,0,300)
F.Position=UDim2.new(.5,-120,.5,-150)
F.BackgroundColor3=Color3.fromRGB(15,15,15)
Instance.new("UICorner",F).CornerRadius=UDim.new(0,12)

-- TITLE
local T=Instance.new("TextLabel",F)
T.Size=UDim2.new(1,0,0,45)
T.BackgroundColor3=Color3.fromRGB(130,0,0)
T.Text="PLAYER WALK"
T.TextColor3=Color3.new(1,1,1)
T.TextSize=20
T.Font=Enum.Font.GothamBold

-- SCROLL
local List=Instance.new("ScrollingFrame",F)
List.Position=UDim2.new(0,5,0,50)
List.Size=UDim2.new(1,-10,1,-55)
List.BackgroundTransparency=1
List.BorderSizePixel=0
List.ScrollBarThickness=5
List.CanvasSize=UDim2.new(0,0,0,0)

local Layout=Instance.new("UIListLayout",List)
Layout.Padding=UDim.new(0,5)

-- KÉO GUI BẰNG CẢM ỨNG
local dragging=false
local dragStart
local startPos

T.InputBegan:Connect(function(i)
	if i.UserInputType==Enum.UserInputType.MouseButton1
	or i.UserInputType==Enum.UserInputType.Touch then
		dragging=true
		dragStart=i.Position
		startPos=F.Position
	end
end)

UIS.InputChanged:Connect(function(i)
	if dragging and (i.UserInputType==Enum.UserInputType.MouseMovement
	or i.UserInputType==Enum.UserInputType.Touch) then
		local d=i.Position-dragStart
		F.Position=UDim2.new(
			startPos.X.Scale,startPos.X.Offset+d.X,
			startPos.Y.Scale,startPos.Y.Offset+d.Y
		)
	end
end)

UIS.InputEnded:Connect(function(i)
	if i.UserInputType==Enum.UserInputType.MouseButton1
	or i.UserInputType==Enum.UserInputType.Touch then
		dragging=false
	end
end)

-- MỤC TIÊU
local Target=nil
local Following=false

-- TẠO PLAYER BUTTON
local function AddPlayer(p)
	if p==M then return end

	local B=Instance.new("TextButton",List)
	B.Size=UDim2.new(1,-5,0,38)
	B.BackgroundColor3=Color3.fromRGB(45,0,0)
	B.Text="→ "..p.Name
	B.TextColor3=Color3.new(1,1,1)
	B.TextSize=15
	B.Font=Enum.Font.GothamBold

	Instance.new("UICorner",B).CornerRadius=UDim.new(0,8)

	B.MouseButton1Click:Connect(function()
		Target=p
		Following=true
	end)
end

for _,p in ipairs(P:GetPlayers()) do
	AddPlayer(p)
end

P.PlayerAdded:Connect(AddPlayer)

-- CẬP NHẬT KÍCH THƯỚC SCROLL
Layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
	List.CanvasSize=UDim2.new(
		0,0,0,
		Layout.AbsoluteContentSize.Y+5
	)
end)

-- ĐI THEO PLAYER LIÊN TỤC
task.spawn(function()
	while task.wait(.1) do
		if Following and Target and Target.Parent then
			local c=M.Character
			local t=Target.Character

			if c and t then
				local h=c:FindFirstChildOfClass("Humanoid")
				local r=t:FindFirstChild("HumanoidRootPart")

				if h and r then
					h:MoveTo(r.Position)
				end
			end
		end
	end
end)

-- ON / OFF
local on=true

Toggle.MouseButton1Click:Connect(function()
	on=not on

	F.Visible=on

	if not on then
		Toggle.Text="OFF"
		Toggle.BackgroundColor3=Color3.fromRGB(45,45,45)
		Following=false
	else
		Toggle.Text="ON"
		Toggle.BackgroundColor3=Color3.fromRGB(130,0,0)
	end
end)

-- PLAYER RỜI SERVER
P.PlayerRemoving:Connect(function(p)
	if Target==p then
		Target=nil
		Following=false
	end
end)
